{
  "$schema": "https://osf.io/echo-chambers-of-one/manifest-v0.2",
  "version": "0.2",
  "preregistration_date": "2026-07-23",
  "preregistration_version": "v0.2 (post deep literature review)",
  "project_title": "Echo Chambers of One: A Causal Test of Interaction Deprivation on Long-Horizon State Stability in Language Agents",
  "models": [
    {
      "id": "deepseek-v4-flash",
      "family": "deepseek",
      "open_source": false,
      "context_k": 1024,
      "thinking_default": true,
      "note": "主力长上下文模型，1M context，1M context 不可用时回退 128K"
    },
    {
      "id": "claude-sonnet-4",
      "family": "claude",
      "open_source": false,
      "context_k": 200,
      "note": "闭源 baseline；用于 contrast with long-context model"
    },
    {
      "id": "gpt-4o",
      "family": "gpt",
      "open_source": false,
      "context_k": 128,
      "note": "闭源 baseline；强工具调用"
    }
  ],
  "tasks": [
    {
      "id": "vending",
      "name": "Vending-Bench style long-horizon economic task",
      "primary_mechanism": "decision_drift",
      "source": "Andon Labs 2025 (arXiv:2502.15840)",
      "scoring_dimensions": ["balance_survival", "pricing_accuracy", "restock_rationality", "anti_meltdown_loops"]
    },
    {
      "id": "longmemeval",
      "name": "LongMemEval style long-term memory task",
      "primary_mechanism": "memory_loss",
      "source": "Wu et al. 2025 ICLR (arXiv:2410.10813)",
      "scoring_dimensions": ["fact_recall", "temporal_consistency", "contradiction_rate", "knowledge_update"]
    },
    {
      "id": "helmet",
      "name": "HELMET style long-context reasoning",
      "primary_mechanism": "context_rot",
      "source": "Princeton 2024 ICLR (arXiv:2410.02694)",
      "scoring_dimensions": ["needle_accuracy", "full_context_reasoning", "multi_hop", "rag_classification"]
    }
  ],
  "conditions": [
    {
      "id": "control_stateless",
      "description": "no per-step state persistence; receives only tool results",
      "external_token_quota_per_100": 0,
      "novelty_enabled": false,
      "feedback_enabled": false,
      "peer_enabled": false,
      "human_enabled": false
    },
    {
      "id": "isolated",
      "description": "only task + self-generated memory; no external signal beyond task feedback",
      "external_token_quota_per_100": 0,
      "novelty_enabled": false,
      "feedback_enabled": false,
      "peer_enabled": false,
      "human_enabled": false
    },
    {
      "id": "novelty",
      "description": "task-irrelevant external documents; no corrective signal",
      "external_token_quota_per_100": 1800,
      "novelty_enabled": true,
      "feedback_enabled": false,
      "peer_enabled": false,
      "human_enabled": false
    },
    {
      "id": "feedback",
      "description": "external scalar correctness signal only",
      "external_token_quota_per_100": 100,
      "novelty_enabled": false,
      "feedback_enabled": true,
      "peer_enabled": false,
      "human_enabled": false
    },
    {
      "id": "peer",
      "description": "interacts with an independently-seeded peer agent",
      "external_token_quota_per_100": 1900,
      "novelty_enabled": true,
      "feedback_enabled": true,
      "peer_enabled": true,
      "human_enabled": false
    },
    {
      "id": "human",
      "description": "supervised by a human (Prolific, n=20)",
      "external_token_quota_per_100": 2000,
      "novelty_enabled": true,
      "feedback_enabled": true,
      "peer_enabled": false,
      "human_enabled": true
    }
  ],
  "context_length_manipulation": {
    "id": "length",
    "values": ["4k", "32k", "128k", "max"],
    "max_per_model": {
      "deepseek-v4-flash": "1M",
      "claude-sonnet-4": "200K",
      "gpt-4o": "128K"
    },
    "note": "orthogonal dimension added in v0.2 to control context rot"
  },
  "checkpoints": [0, 100, 500, 1000, 2000, 5000, 10000],
  "seeds": [11, 22, 33],
  "state_view_counterfactuals": {
    "interval_steps": 1000,
    "views": [
      {"id": "raw", "description": "complete raw state"},
      {"id": "structured", "description": "same length but JSON-tabular"},
      {"id": "fake_memory", "description": "same length but with 3 injected false memories"},
      {"id": "lorem", "description": "same length task-irrelevant lorem ipsum"}
    ],
    "decision_rule": "isolation effect is 'real loneliness' only if (a) and (b) show feedback > isolated AND (c) eliminates the gap"
  },
  "failure_attribution_schema": {
    "source": "HORIZON (arXiv:2604.11978)",
    "categories": [
      {"id": "planning", "definition": "current action choice inconsistent with goal"},
      {"id": "memory_loss", "definition": "contradicts past action or fact"},
      {"id": "historical_error_accumulation", "definition": "self-reinforcing loop of early errors"}
    ],
    "judge_model": "separate LLM-as-a-Judge; not same model as agent"
  },
  "anti_degradation_mechanisms": [
    {"id": "self_talk", "source": "Wei et al. 2022 CoT", "expected_effect": "may_backfire", "warning_source": "NoLiMa (arXiv:2502.05167)"},
    {"id": "episodic_recall", "source": "A-MEM (arXiv:2502.12110)", "expected_effect": "medium"},
    {"id": "source_tagging", "source": "HippoRAG 2 (arXiv:2502.14802)", "expected_effect": "medium"},
    {"id": "periodic_reset", "source": "weak", "expected_effect": "may_be_false_positive"},
    {"id": "external_grounding", "source": "CRAG (arXiv:2401.15884)", "expected_effect": "large"},
    {"id": "independent_critic", "source": "LATS (arXiv:2310.04406)", "expected_effect": "large_if_truly_independent"},
    {"id": "semantic_compression", "source": "Mem0 (arXiv:2504.19413)", "expected_effect": "medium"},
    {"id": "grounding_document", "source": "LoCoMo (arXiv:2402.17753)", "expected_effect": "medium"}
  ],
  "adversarial_controls": [
    {"id": "oracle_feedback", "description": "perfect external signal; upper bound"},
    {"id": "adversarial_feedback", "description": "deliberately wrong feedback; lower bound"}
  ],
  "outcomes": {
    "primary": ["accuracy", "planning_score", "decision_score", "calibration", "memory_score"],
    "secondary": ["survival_step", "first_unrecoverable_error_step", "task_success_rate", "tool_call_failure_rate"],
    "attribution": ["planning_failure_rate", "memory_loss_rate", "historical_error_accumulation_rate"]
  },
  "design_summary": {
    "models": 3,
    "lengths": 4,
    "conditions": 6,
    "tasks": 3,
    "seeds": 3,
    "total_cells": 648,
    "total_trajectories": 1944,
    "v0_1_summary": "7 models x 6 conditions x 3 tasks x >=20 repetitions = 2520 cells (revised for context-rot control)"
  },
  "exclusion_rules": [
    "trajectories with API failure rate > 20% are removed and replaced",
    "trajectories with > 50% missing tool returns are removed and replaced",
    "trajectories ending in environment crashes are removed and replaced",
    "no exclusion based on agent performance"
  ],
  "deviation_contingencies": [
    {"trigger": "LMM random-effect covariance singular", "action": "LMM -> GEE (independence) -> pooled OLS; record method and fallback_reason in lmm_results.json"},
    {"trigger": "n_groups < 5 per cell", "action": "skip LMM/GEE; go directly to pooled OLS; cell flagged as low-power"},
    {"trigger": "API failure rate > 20%", "action": "cell excluded; report failure rate"},
    {"trigger": "all Holm-corrected p > 0.05", "action": "report null; provide Benjamini-Hochberg FDR as sensitivity"},
    {"trigger": "deepseek-v4-flash 1M context unavailable", "action": "fall back to 128K length"},
    {"trigger": "self-talk in absence of oracle feedback reverses direction", "action": "test semantic_compression + independent_critic as two-factor design"},
    {"trigger": "3-task interaction model fails to converge", "action": "fall back to per-task LMM, report each separately"}
  ],
  "budget_estimate": {
    "total_trajectories": 1944,
    "tokens_per_trajectory": 2000000,
    "total_tokens_billion": 3.89,
    "cost_breakdown": {
      "deepseek_v4_flash_cache_hit": {"fraction": 0.7, "rate_per_million": 0.0028, "usd": 7.6},
      "deepseek_v4_flash_cache_miss": {"fraction": 0.1, "rate_per_million": 0.14, "usd": 54.4},
      "claude_sonnet_4": {"fraction": 0.1, "rate_per_million": 3.0, "usd": 1170},
      "gpt_4o": {"fraction": 0.1, "rate_per_million": 2.5, "usd": 970}
    },
    "total_usd_low": 1500,
    "total_usd_high": 2500,
    "note": "with full 10000-step horizon and anthropic caching; lower if reduce to 5000 steps"
  },
  "timeline": {
    "stage_1_internal_review": "2026-07-22 to 2026-08-15",
    "stage_1_osf_freeze": "2026-08-15 to 2026-09-01",
    "stage_1_submission_aamas_2027_rr": "2026-09-01 to 2026-09-15",
    "pilot_n3_per_cell": "2026-09 to 2026-10",
    "formal_data_collection": "2026-10 to 2026-12",
    "stage_2_full_paper": "2027-01 to 2027-02"
  },
  "v0_1_to_v0_2_changes": [
    "7 models -> 3 models (focused on closed-source + 1M-context workhorse)",
    "added context_length_manipulation as 4th orthogonal dimension (4K, 32K, 128K, model max)",
    "3 tasks now orthogonally cover decision_drift / memory_loss / context_rot",
    "added 4 state-view counterfactuals to disentangle context rot from isolation",
    "added failure attribution schema (HORIZON-style) as secondary outcome",
    "8 anti-degradation mechanisms now have adversarial controls (oracle / adversarial feedback)",
    "repetitions reduced from >=20 to 3 (Vending-Bench reports large run-to-run variance)",
    "budget re-estimated at $1500-$2500 (was $200-$500); longer context with Anthropic caching"
  ]
}